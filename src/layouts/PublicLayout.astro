---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Surat Peminjaman 3D Printer' } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-kampus.png" />
    <title>{title} - Inventaris 3D Printer</title>
  </head>

  <body class="min-h-screen bg-slate-100 font-sans text-slate-900 antialiased">
    <header class="bg-linear-to-b from-blue-900 to-[#172554] text-white">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white p-1.5 ring-4 ring-white/10">
            <img src="/logo-kampus.png" alt="Logo kampus" class="max-h-full max-w-full object-contain" />
          </span>
          <span class="text-lg font-bold leading-tight tracking-tight">Inventaris 3D Printer</span>
        </a>
        <a href="/login" class="text-sm text-blue-100 underline-offset-4 hover:text-white hover:underline">Login Admin</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8 sm:py-10">
      <slot />
    </main>

    <footer class="pb-8 text-center text-xs text-slate-400">Politeknik Manufaktur Bandung</footer>
  </body>
</html>
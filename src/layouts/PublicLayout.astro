---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Surat Peminjaman 3D Printer',
  description = 'Sistem inventaris dan peminjaman 3D printer laboratorium',
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14286b" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Inventaris 3D Printer`} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/logo-kampus.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    <title>{title} | Inventaris 3D Printer</title>
    <slot name="head" />
  </head>

  <body
    class="min-h-dvh bg-[#f4f6fb] text-slate-900 antialiased selection:bg-orange-200 selection:text-slate-900 print:bg-white"
  >
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-blue-900 focus:shadow-lg focus:ring-2 focus:ring-orange-500"
    >
      Langsung ke konten
    </a>

    <!-- Latar berpola grid seperti bed printer 3D -->
    <div aria-hidden="true" class="bed-grid pointer-events-none fixed inset-0 -z-10 print:hidden"></div>

    <header class="sticky top-0 z-50 bg-[#14286b] text-white shadow-lg shadow-blue-950/15 print:hidden">
      <div class="mx-auto flex max-w-3xl items-center gap-3.5 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="group -mx-2 flex items-center gap-3.5 rounded-xl px-2 py-1 outline-none focus-visible:ring-2 focus-visible:ring-orange-400"
        >
          <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-white p-1.5">
            <img
              src="/logo-kampus.png"
              alt="Logo kampus"
              width="44"
              height="44"
              class="max-h-full max-w-full object-contain"
            />
          </span>

          <span class="flex flex-col leading-tight">
            <span class="text-base font-extrabold tracking-tight sm:text-lg">Inventaris 3D Printer</span>
            <span class="text-[13px] font-medium text-blue-200">Peminjaman alat laboratorium</span>
          </span>
        </a>
      </div>

      <!-- Garis aksen tipis (hapus baris ini kalau tidak mau ada garis sama sekali) -->
      <div aria-hidden="true" class="h-0.5 w-full bg-orange-500"></div>
    </header>

    <main id="konten" class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 print:max-w-none print:p-0">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl px-4 pb-10 pt-2 text-sm text-slate-500 sm:px-6 print:hidden">
      <div class="border-t border-slate-300/70 pt-5">
        Inventaris 3D Printer Laboratorium &copy; {year}
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bed-line: rgb(20 40 107 / 0.06);
  }

  body {
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  .bed-grid {
    background-image:
      linear-gradient(var(--bed-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bed-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  :focus-visible {
    outline: 2px solid #f97316;
    outline-offset: 2px;
  }

  @media print {
    @page {
      margin: 2cm;
    }
  }
</style>
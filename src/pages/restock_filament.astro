---
import AdminLayout from '../layouts/AdminLayout.astro';
import { supabase } from '../lib/supabase';

export const prerender = false;

const TARGET = '/restock_filament';

// --- Tangani submit form (Post → Redirect → Get supaya refresh tidak kirim ulang) ---
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const filament_id = form.get('filament_id')?.toString();
  const jumlah = Number(form.get('jumlah_gram'));
  const tanggal = form.get('tanggal_restock')?.toString() || null;
  const catatan = form.get('catatan')?.toString().trim() || null;

  const gagal = (pesan: string) => Astro.redirect(`${TARGET}?error=${encodeURIComponent(pesan)}`, 303);

  if (!filament_id) return gagal('Filamen belum dipilih.');
  if (!Number.isInteger(jumlah) || jumlah <= 0) return gagal('Jumlah harus bilangan bulat lebih dari 0.');

  const { error: rpcError } = await supabase.rpc('restock_filament', {
    p_filament_id: filament_id,
    p_jumlah_gram: jumlah,
    p_tanggal: tanggal,
    p_catatan: catatan,
  });

  if (rpcError) return gagal(rpcError.message);
  return Astro.redirect(`${TARGET}?ok=${jumlah}`, 303);
}

// --- Data tampilan ---
const ok = Astro.url.searchParams.get('ok');
const pesanError = Astro.url.searchParams.get('error');

const { data: filamentData } = await supabase
  .from('filaments')
  .select('id, jenis_warna, sisa_stok_gram')
  .order('created_at', { ascending: true });
const filaments: any[] = filamentData ?? [];

const { data: riwayatData, error: riwayatError } = await supabase
  .from('filament_restocks')
  .select('id, jumlah_gram, tanggal_restock, catatan, filaments(jenis_warna)')
  .order('tanggal_restock', { ascending: false })
  .order('created_at', { ascending: false })
  .limit(50);
const riwayat: any[] = riwayatData ?? [];

const formatTanggal = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
};
// Tanggal hari ini (zona WIB) sebagai nilai default input
const hariIni = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Jakarta' });

const inputClass =
  'mt-1 block w-full rounded-md border border-slate-300 p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700';
---

<AdminLayout title="Restock Filamen">

  <section class="bg-white p-6 rounded-lg border border-slate-200 mb-6">
    <h2 class="text-lg font-semibold text-blue-900">Tambah stok filamen</h2>
    <p class="text-sm text-slate-500 mt-1 mb-5">
      Catat setiap pembelian atau penerimaan filamen baru. Sisa stok bertambah otomatis dan tercatat di riwayat.
    </p>

    {ok && (
      <p class="mb-5 rounded-md bg-green-50 border border-green-200 p-3 text-sm text-green-700">
        Restock berhasil: +{ok} g ditambahkan ke stok.
      </p>
    )}
    {pesanError && (
      <p class="mb-5 rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700">
        Gagal: {pesanError}
      </p>
    )}

    {filaments.length === 0 ? (
      <p class="text-sm text-slate-500">Belum ada data filamen di database.</p>
    ) : (
      <form method="post" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
        <div>
          <label class="block text-sm font-medium text-slate-700" for="filament_id">Filamen</label>
          {filaments.length === 1 ? (
            <>
              <input type="hidden" name="filament_id" value={filaments[0].id} />
              <div class="mt-1 rounded-md border border-slate-200 bg-slate-50 p-2 text-sm">
                {filaments[0].jenis_warna}
                <span class="text-slate-500"> · sisa {filaments[0].sisa_stok_gram} g</span>
              </div>
            </>
          ) : (
            <select id="filament_id" name="filament_id" required class={inputClass}>
              {filaments.map((f) => (
                <option value={f.id}>{f.jenis_warna} (sisa {f.sisa_stok_gram} g)</option>
              ))}
            </select>
          )}
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700" for="jumlah_gram">Jumlah (gram)</label>
          <input id="jumlah_gram" type="number" name="jumlah_gram" min="1" step="1" required class={inputClass} placeholder="1000" />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700" for="tanggal_restock">Tanggal</label>
          <input id="tanggal_restock" type="date" name="tanggal_restock" value={hariIni} required class={inputClass} />
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700" for="catatan">Catatan (opsional)</label>
          <input id="catatan" type="text" name="catatan" class={inputClass} placeholder="mis. 1 roll, pengadaan 2026" />
        </div>

        <div class="md:col-span-4">
          <button type="submit" class="bg-blue-900 text-white px-6 py-2 rounded-md hover:bg-blue-800 text-sm font-medium transition">
            Simpan restock
          </button>
        </div>
      </form>
    )}
  </section>

  <section class="bg-white rounded-lg border border-slate-200">
    <div class="p-6 pb-4">
      <h2 class="text-lg font-semibold text-blue-900">Riwayat restock</h2>
      <p class="text-sm text-slate-500 mt-1">50 restock terbaru.</p>
    </div>

    {riwayatError && (
      <p class="mx-6 mb-6 rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700">
        Gagal memuat riwayat: {riwayatError.message}. Pastikan tabel filament_restocks sudah dibuat.
      </p>
    )}

    {!riwayatError && riwayat.length === 0 ? (
      <p class="px-6 pb-8 text-sm text-slate-500">Belum ada restock tercatat.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-600 border-y border-slate-200">
            <tr>
              <th class="px-4 py-3 font-medium whitespace-nowrap">Tanggal</th>
              <th class="px-4 py-3 font-medium">Filamen</th>
              <th class="px-4 py-3 font-medium text-right whitespace-nowrap">Jumlah</th>
              <th class="px-4 py-3 font-medium">Catatan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {riwayat.map((r) => (
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 whitespace-nowrap">{formatTanggal(r.tanggal_restock)}</td>
                <td class="px-4 py-3">{r.filaments?.jenis_warna ?? '-'}</td>
                <td class="px-4 py-3 text-right font-medium text-green-700 whitespace-nowrap">+{r.jumlah_gram} g</td>
                <td class="px-4 py-3">{r.catatan ?? '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

</AdminLayout>
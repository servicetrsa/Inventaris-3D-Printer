---
import PublicLayout from '../layouts/PublicLayout.astro';
import { SURAT, PRODI, MAKS_BARIS } from '../lib/surat-config';

const field =
  'block w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:bg-slate-100';
const label = 'block text-sm font-medium text-slate-700';
const card = 'rounded-xl border border-slate-200 bg-white p-4 sm:p-6';
const kolom =
  'sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_2.5rem]';
---

<PublicLayout>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-blue-900">Surat Peminjaman 3D Printer</h1>
    <p class="mt-1 text-sm text-slate-600">
      Isi formulir, lalu unduh suratnya dalam bentuk PDF. Cetak, minta tanda tangan, dan serahkan ke Pranata Laboratorium Pendidikan.
    </p>
  </div>

  <form id="form-surat" class="space-y-5">
    <!-- 1. Data pemohon -->
    <section class={card}>
      <h2 class="font-semibold text-slate-900">1. Data pemohon</h2>

      <div class="mt-4">
        <span class={label}>Status</span>
        <div class="mt-1 inline-flex rounded-lg bg-slate-100 p-1" role="radiogroup" aria-label="Status pemohon">
          <label class="cursor-pointer">
            <input type="radio" name="status" value="mahasiswa" checked class="peer sr-only" />
            <span class="inline-flex h-8 items-center rounded-md px-4 text-sm font-medium text-slate-600 transition peer-checked:bg-white peer-checked:text-blue-900 peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">Mahasiswa</span>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="status" value="pegawai" class="peer sr-only" />
            <span class="inline-flex h-8 items-center rounded-md px-4 text-sm font-medium text-slate-600 transition peer-checked:bg-white peer-checked:text-blue-900 peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">Pegawai / Dosen</span>
          </label>
        </div>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class={label}>Nama lengkap</span>
          <input type="text" name="nama" required autocomplete="name" class={field + ' mt-1'} />
        </label>
        <label class="block">
          <span id="lbl-id" class={label}>NIM</span>
          <input type="text" name="id_no" required class={field + ' mt-1'} />
        </label>

        <label data-for="mahasiswa">
          <span class={label}>Program studi</span>
          <select name="prodi" required class={field + ' mt-1'}>
            <option value="">Pilih program studi</option>
            {PRODI.map((p) => <option value={p}>{p}</option>)}
          </select>
        </label>
        <label data-for="mahasiswa">
          <span class={label}>Jurusan</span>
          <input type="text" name="jurusan" required value={SURAT.jurusanDefault} class={field + ' mt-1'} />
          <span class="mt-1 block text-xs text-slate-500">Terisi otomatis, ubah bila jurusanmu berbeda.</span>
        </label>
        <label class="sm:col-span-2" data-for="mahasiswa">
          <span class={label}>Dosen terkait</span>
          <input type="text" name="dosen" class={field + ' mt-1'} />
        </label>

        <label class="hidden sm:col-span-2" data-for="pegawai">
          <span class={label}>Unit kerja</span>
          <input type="text" name="unit" required disabled class={field + ' mt-1'} />
        </label>
      </div>
    </section>

    <!-- 2. Keperluan -->
    <section class={card}>
      <h2 class="font-semibold text-slate-900">2. Keperluan</h2>
      <label class="mt-4 block">
        <span class={label}>Digunakan untuk</span>
        <input type="text" name="keperluan" required autocomplete="off" class={field + ' mt-1'} />
      </label>
    </section>

    <!-- 3. Jadwal -->
    <section class={card}>
      <h2 class="font-semibold text-slate-900">3. Jadwal pemakaian</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-500">
        Isi rencana pemakaian. Baris kosong dan kolom paraf pada surat diisi tangan setelah alat digunakan.
      </p>

      <div class={'mt-5 mb-2 hidden gap-2 text-xs font-medium text-slate-500 sm:grid ' + kolom}>
        <span>Tanggal</span><span>Waktu mulai</span><span>Waktu selesai</span><span>Volume (gram)</span><span></span>
      </div>
      <div id="rows" class="mt-5 space-y-4 sm:mt-0 sm:space-y-2"></div>

      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        <button
          type="button"
          id="btn-add-row"
          class="inline-flex h-9 items-center rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-blue-900 transition hover:bg-blue-50 disabled:opacity-50"
        >+ Tambah jadwal</button>
        <span class="text-xs text-slate-400">maksimal {MAKS_BARIS} baris</span>
      </div>
    </section>

    <div id="err" role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>
    <div id="ok" class="hidden rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm leading-relaxed text-emerald-800">
      Surat berhasil dibuat. Jika lewat browser HP, cek file PDF-nya di menu <strong>Download</strong> (⋮). Lalu cetak, minta tanda tangan, dan serahkan ke Pranata Laboratorium Pendidikan.
    </div>

    <button
      type="submit"
      id="btn-submit"
      class="h-11 w-full rounded-lg bg-blue-900 px-5 text-sm font-semibold text-white transition hover:bg-blue-800 disabled:opacity-60"
    >Buat surat (PDF)</button>
  </form>

  <!-- Template baris jadwal -->
  <template id="row-tpl">
    <div data-row class={'grid grid-cols-2 gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3 sm:items-center sm:gap-2 sm:border-0 sm:bg-transparent sm:p-0 ' + kolom}>
      <p data-no class="col-span-2 text-xs font-semibold uppercase tracking-wide text-slate-500 sm:hidden"></p>

      <label class="col-span-2 block sm:col-span-1">
        <span class="mb-1 block text-xs font-medium text-slate-500 sm:hidden">Tanggal</span>
        <input type="date" data-f="tanggal" required aria-label="Tanggal" class={field} />
      </label>

      <label class="block">
        <span class="mb-1 block text-xs font-medium text-slate-500 sm:hidden">Waktu mulai</span>
        <input type="time" data-f="mulai" required aria-label="Waktu mulai" class={field} />
      </label>

      <label class="block">
        <span class="mb-1 block text-xs font-medium text-slate-500 sm:hidden">Waktu selesai</span>
        <input type="time" data-f="selesai" required aria-label="Waktu selesai" class={field} />
      </label>

      <label class="col-span-2 block sm:col-span-1">
        <span class="mb-1 block text-xs font-medium text-slate-500 sm:hidden">Volume (gram)</span>
        <input type="number" data-f="volume" required min="1" step="1" inputmode="numeric" placeholder="gram" aria-label="Volume (gram)" class={field} />
      </label>

      <button
        type="button"
        data-remove
        aria-label="Hapus baris"
        class="col-span-2 h-10 rounded-lg text-sm text-slate-500 transition hover:bg-red-50 hover:text-red-600 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-slate-500 sm:col-span-1"
      >&times;<span class="ml-1 sm:hidden">Hapus jadwal ini</span></button>
    </div>
  </template>
</PublicLayout>

<script>
  import { SURAT, MAKS_BARIS } from '../lib/surat-config';

  type Data = {
    status: string; nama: string; idNo: string; prodi: string; jurusan: string;
    unit: string; dosen: string; keperluan: string;
  };
  type Baris = { tanggal: string; mulai: string; selesai: string; volume: string };

  const form = document.getElementById('form-surat') as HTMLFormElement;
  const rowsEl = document.getElementById('rows') as HTMLElement;
  const tpl = document.getElementById('row-tpl') as HTMLTemplateElement;
  const btnAdd = document.getElementById('btn-add-row') as HTMLButtonElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const errEl = document.getElementById('err') as HTMLElement;
  const okEl = document.getElementById('ok') as HTMLElement;
  const lblId = document.getElementById('lbl-id') as HTMLElement;

  // ---------- Status pemohon ----------
  const statusVal = () => (form.querySelector('input[name="status"]:checked') as HTMLInputElement).value;
  function terapkanStatus() {
    const s = statusVal();
    document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => {
      const on = el.dataset.for === s;
      el.classList.toggle('hidden', !on);
      el.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input,select').forEach((i) => (i.disabled = !on));
    });
    lblId.textContent = s === 'mahasiswa' ? 'NIM' : 'NIP / NIK';
  }
  form.querySelectorAll('input[name="status"]').forEach((r) => r.addEventListener('change', terapkanStatus));
  terapkanStatus();

  // ---------- Baris jadwal ----------
  function refreshRows() {
    const n = rowsEl.children.length;
    rowsEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((b) => (b.disabled = n <= 1));
    rowsEl.querySelectorAll<HTMLElement>('[data-no]').forEach((p, i) => (p.textContent = `Jadwal ${i + 1}`));
    btnAdd.disabled = n >= MAKS_BARIS;
  }
  function addRow() {
    if (rowsEl.children.length >= MAKS_BARIS) return;
    rowsEl.appendChild(tpl.content.firstElementChild!.cloneNode(true));
    refreshRows();
  }
  rowsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-remove]');
    if (b && rowsEl.children.length > 1) {
      b.closest('[data-row]')!.remove();
      refreshRows();
    }
  });
  btnAdd.addEventListener('click', addRow);
  addRow();

  // ---------- Ambil & validasi data ----------
  const isi = (name: string) =>
    ((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '').trim();

  function ambilData(): Data {
    return {
      status: statusVal(), nama: isi('nama'), idNo: isi('id_no'), prodi: isi('prodi'),
      jurusan: isi('jurusan'), unit: isi('unit'), dosen: isi('dosen'), keperluan: isi('keperluan'),
    };
  }
  function ambilBaris(): Baris[] {
    return Array.from(rowsEl.querySelectorAll('[data-row]')).map((r) => {
      const g = (f: string) => (r.querySelector(`[data-f="${f}"]`) as HTMLInputElement).value;
      return { tanggal: g('tanggal'), mulai: g('mulai'), selesai: g('selesai'), volume: g('volume') };
    });
  }
  function validasi(rows: Baris[]): string[] {
    const e: string[] = [];
    rows.forEach((r, i) => {
      if (r.selesai <= r.mulai) e.push(`Jadwal ${i + 1}: waktu selesai harus setelah waktu mulai.`);
      if (!(Number(r.volume) >= 1)) e.push(`Jadwal ${i + 1}: volume minimal 1 gram.`);
    });
    return e;
  }

  // ---------- Format tanggal ----------
  const BULAN = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
  const tglId = (iso: string) => {
    const [y, m, d] = iso.split('-').map(Number);
    return `${d} ${BULAN[m - 1]} ${y}`;
  };
  const hariIniWib = () => new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' });

  // ---------- Logo ----------
  function muatLogo(): Promise<{ url: string; w: number; h: number } | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => {
        const c = document.createElement('canvas');
        c.width = img.naturalWidth;
        c.height = img.naturalHeight;
        c.getContext('2d')!.drawImage(img, 0, 0);
        resolve({ url: c.toDataURL('image/png'), w: img.naturalWidth, h: img.naturalHeight });
      };
      img.onerror = () => resolve(null);
      img.src = '/logo-kampus.png';
    });
  }

  // ---------- Bangun PDF ----------
  async function buatPdf(d: Data, rows: Baris[]) {
    const [{ jsPDF }, logo] = await Promise.all([import('jspdf'), muatLogo()]);
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const L = 25, R = 185, W = R - L, LH = 5;
    const mhs = d.status === 'mahasiswa';
    const idLabel = mhs ? 'NIM' : 'NIP/NIK';

    const sorted = [...rows].sort((a, b) => (a.tanggal + a.mulai).localeCompare(b.tanggal + b.mulai));
    const awal = sorted[0].tanggal;
    const akhir = sorted[sorted.length - 1].tanggal;
    const tglPinjam = awal === akhir ? tglId(awal) : `${tglId(awal)} s.d. ${tglId(akhir)}`;

    const font = (bold = false, size = 11) => {
      doc.setFont('times', bold ? 'bold' : 'normal');
      doc.setFontSize(size);
    };
    const teks = (t: string | string[], x: number, yy: number, o?: { align?: 'left' | 'center' | 'right' }) =>
      doc.text(t, x, yy, o);

    // Kop surat
    if (logo) {
      const lw = 22;
      doc.addImage(logo.url, 'PNG', L - 3, 11, lw, lw * (logo.h / logo.w));
    }
    font(true, 16);
    teks(SURAT.kop.nama, 112, 20, { align: 'center' });
    font(false, 10.5);
    teks(SURAT.kop.alamat, 112, 26.5, { align: 'center' });
    doc.setLineWidth(0.5);
    doc.line(L - 5, 35, R + 5, 35);
    doc.setLineWidth(0.2);

    font();
    teks(`${SURAT.kop.kota}, ${tglId(hariIniWib())}`, R, 43, { align: 'right' });

    let y = 51;
    const baris = (lbl: string, nilai: string, yy: number, co: number) => {
      teks(lbl, L, yy);
      teks(':', L + co, yy);
      const ls = doc.splitTextToSize(nilai || ' ', W - co - 4) as string[];
      teks(ls, L + co + 4, yy);
      return yy + ls.length * LH;
    };

    y = baris('Lampiran', '1', y, 22);
    y = baris('Perihal', SURAT.perihal, y, 22);
    y = baris('Kepada', '', y, 22);
    const xi = L + 26;
    teks(`Yth. ${SURAT.penerima.sapaan} ${SURAT.penerima.nama}`, xi, y); y += LH;
    teks(SURAT.penerima.instansi, xi, y); y += LH;
    teks('Di Tempat', xi, y); y += LH * 2;

    teks('Dengan Hormat,', L, y); y += LH * 1.6;
    teks('Saya yang bertanda tangan di bawah ini:', L, y); y += LH * 1.3;

    const ident: [string, string][] = [['Nama', d.nama], [idLabel, d.idNo]];
    if (mhs) {
      ident.push(['Program Studi', d.prodi], ['Jurusan', d.jurusan]);
      if (d.dosen) ident.push(['Dosen Terkait', d.dosen]);
    } else {
      ident.push(['Unit Kerja', d.unit]);
    }
    ident.push(['Tgl Peminjaman', tglPinjam]);
    for (const [k, v] of ident) y = baris(k, v, y, 34);
    y += LH * 0.8;

    // Paragraf 1 (keperluan dicetak tebal) — rata kiri-kanan (justify)
    const parts = [
      { t: `Bersama surat ini, saya bermaksud mengajukan permohonan izin untuk meminjam barang milik ${SURAT.penerima.sapaan} berupa 1 (satu) unit mesin 3D Printer. Peminjaman alat tersebut akan saya gunakan untuk keperluan:` },
      { t: d.keperluan, b: true },
    ];
    type Kata = { t: string; b: boolean; w: number };
    const kata: Kata[] = [];
    for (const p of parts) {
      font(!!p.b);
      for (const t of p.t.split(' ').filter(Boolean)) {
        kata.push({ t, b: !!p.b, w: doc.getTextWidth(t) });
      }
    }
    font();
    const spN = doc.getTextWidth(' ');
    const garis: Kata[][] = [[]];
    let lebar = 0;
    for (const k of kata) {
      const cur = garis[garis.length - 1];
      const tambah = cur.length ? spN + k.w : k.w;
      if (cur.length && lebar + tambah > W) {
        garis.push([k]);
        lebar = k.w;
      } else {
        cur.push(k);
        lebar += tambah;
      }
    }
    garis.forEach((ln, i) => {
      const terakhir = i === garis.length - 1;
      const total = ln.reduce((s, k) => s + k.w, 0);
      const gap = !terakhir && ln.length > 1 ? (W - total) / (ln.length - 1) : spN;
      let px = L;
      ln.forEach((k) => {
        font(k.b);
        teks(k.t, px, y);
        px += k.w + gap;
      });
      if (!terakhir) y += LH;
    });
    font();
    y += LH + 2.5;

    // Paragraf biasa — rata kiri-kanan (baris terakhir tetap rata kiri)
    const para = (t: string) => {
      const ls = doc.splitTextToSize(t, W) as string[];
      ls.forEach((ln, i) => {
        const yl = y + i * LH;
        const kt = ln.split(' ').filter(Boolean);
        if (i === ls.length - 1 || kt.length < 2) {
          teks(ln, L, yl);
          return;
        }
        const total = kt.reduce((s, k) => s + doc.getTextWidth(k), 0);
        const gap = (W - total) / (kt.length - 1);
        let px = L;
        kt.forEach((k) => {
          teks(k, px, yl);
          px += doc.getTextWidth(k) + gap;
        });
      });
      y += ls.length * LH + 2.5;
    };
    para('Selama masa peminjaman, saya berkomitmen untuk menjaga, merawat, dan menggunakan alat tersebut sesuai dengan prosedur yang berlaku. Saya juga bersedia bertanggung jawab penuh apabila terjadi kerusakan atau kehilangan atas alat tersebut selama berada dalam tanggung jawab saya.');
    para(`Demikian surat permohonan peminjaman ini saya sampaikan. Atas perhatian, bantuan, dan izin yang ${SURAT.penerima.sapaan} berikan, saya ucapkan terima kasih.`);

    // Tanda tangan
    if (y + 80 > 285) { doc.addPage(); y = 25; }
    font();
    const nama = (cxx: number, yy: number, t: string, maxW = 76) => {
      const ls = doc.splitTextToSize(t, maxW) as string[];
      ls.forEach((ln, i) => {
        const yl = yy + i * LH;
        teks(ln, cxx, yl, { align: 'center' });
        const w = doc.getTextWidth(ln);
        doc.line(cxx - w / 2, yl + 0.9, cxx + w / 2, yl + 0.9);
      });
      return ls.length;
    };

    // Kolom kiri melebar mengikuti panjang nama penyetuju supaya tetap satu baris
    const wPenyetuju = doc.getTextWidth(SURAT.penyetuju.nama);
    const wPengetahui = doc.getTextWidth(SURAT.pengetahui.nama);
    const cl = L + Math.max(40, wPenyetuju / 2);
    const cr = Math.max(R - 36, cl + wPenyetuju / 2 + 8 + wPengetahui / 2);
    const GAP_NIP = LH + 1.5; // jarak nama (bergaris bawah) ke baris NIM/NIP

    y += 3;
    teks('Hormat Saya,', cl, y, { align: 'center' });
    const yn = y + 22;
    nama(cl, yn, d.nama);
    teks(`${idLabel}. ${d.idNo}`, cl, yn + GAP_NIP, { align: 'center' });

    const y2 = yn + LH + 16; // jarak ke blok "Menyetujui" / "Mengetahui"
    teks('Menyetujui,', cl, y2, { align: 'center' });
    teks('Mengetahui,', cr, y2, { align: 'center' });
    teks(SURAT.pengetahui.jabatan, cr, y2 + LH, { align: 'center' });

    const yn2 = y2 + 22;
    nama(cl, yn2, SURAT.penyetuju.nama, 120);
    nama(cr, yn2, SURAT.pengetahui.nama, 120);
    teks(`NIP. ${SURAT.penyetuju.nip}`.trimEnd(), cl, yn2 + GAP_NIP, { align: 'center' });
    teks(`NIP. ${SURAT.pengetahui.nip}`.trimEnd(), cr, yn2 + GAP_NIP, { align: 'center' });

    // Halaman 2: tabel waktu pemakaian
    doc.addPage();
    let ty = 25;
    font(true, 12);
    teks('Waktu Pemakaian', L, ty);
    font(false, 10);
    ty += 5.5;
    teks(SURAT.catatanTabel, L, ty);
    ty += 5;

    const cols = [
      { h: 'No.', w: 12 }, { h: 'Tanggal', w: 36 }, { h: 'Waktu Mulai', w: 26 },
      { h: 'Waktu Selesai', w: 26 }, { h: 'Volume (gram)', w: 30 }, { h: 'Paraf Pengguna', w: 30 },
    ];
    const RH = 9;
    const cell = (x: number, yy: number, w: number, t: string) => {
      doc.rect(x, yy, w, RH);
      if (t) teks(t, x + w / 2, yy + RH / 2 + 1.3, { align: 'center' });
    };
    font(false, 10);
    let x = L;
    cols.forEach((c) => { cell(x, ty, c.w, c.h); x += c.w; });
    ty += RH;
    for (let i = 0; i < MAKS_BARIS; i++) {
      const r = sorted[i];
      const vals = r
        ? [String(i + 1), tglId(r.tanggal), r.mulai, r.selesai, `${r.volume} gram`, '']
        : ['', '', '', '', '', ''];
      x = L;
      cols.forEach((c, k) => { cell(x, ty, c.w, vals[k]); x += c.w; });
      ty += RH;
    }

    const slug = d.nama.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '') || 'Pemohon';
    doc.save(`Surat-Peminjaman-3D-Printer-${slug}.pdf`);
  }

  // ---------- Submit ----------
  function tampilError(list: string[]) {
    errEl.innerHTML = list.map((t) => `<p>${t}</p>`).join('');
    errEl.classList.remove('hidden');
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    const rows = ambilBaris();
    const errors = validasi(rows);
    if (errors.length) { tampilError(errors); return; }

    btnSubmit.disabled = true;
    btnSubmit.textContent = 'Membuat PDF...';
    try {
      await buatPdf(ambilData(), rows);

      // Kosongkan form setelah surat berhasil dibuat
      rowsEl.innerHTML = '';
      addRow();
      form.reset();
      terapkanStatus();

      okEl.classList.remove('hidden');
      okEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (err) {
      console.error(err);
      tampilError(['Gagal membuat PDF. Muat ulang halaman lalu coba lagi.']);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.textContent = 'Buat surat (PDF)';
    }
  });
</script>
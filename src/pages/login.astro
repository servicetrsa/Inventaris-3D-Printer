---
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login Admin - Inventaris 3D Printer</title>
  </head>
  <body class="bg-gray-100 flex items-center justify-center min-h-dvh p-4">
    <div class="bg-white p-6 sm:p-8 rounded-lg shadow-md w-full max-w-md">
      <h1 class="text-2xl font-bold text-blue-900 mb-6 text-center">Login Admin</h1>
      
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Email</label>
          <input type="email" id="email" required autocomplete="email" inputmode="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-3 sm:p-2 text-base sm:text-sm" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700">Password</label>
          <div class="relative mt-1">
            <input type="password" id="password" required autocomplete="current-password" class="block w-full rounded-md border-gray-300 shadow-sm border p-3 sm:p-2 pr-12 sm:pr-12 text-base sm:text-sm" />
            <button
              type="button"
              id="toggle-pw"
              aria-label="Tampilkan password"
              aria-pressed="false"
              class="absolute right-1 top-1/2 -translate-y-1/2 rounded-md p-2 text-gray-500 transition hover:text-blue-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            >
              <!-- Mata terbuka: password sedang tersembunyi -->
              <svg id="eye-on" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              <!-- Mata dicoret: password sedang terlihat -->
              <svg id="eye-off" class="hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
              </svg>
            </button>
          </div>
        </div>

        <button id="btn-login" type="submit" class="w-full bg-blue-900 text-white py-3 sm:py-2 rounded-md hover:bg-blue-800 text-sm font-medium transition disabled:opacity-60">
          Masuk ke Dashboard
        </button>
      </form>
      
      <p id="error-msg" class="text-red-500 text-xs mt-4 text-center hidden"></p>
    </div>

    <script>
      import { createSupabaseBrowser } from '../lib/supabase-auth';

      const supabase = createSupabaseBrowser();

      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorMsg = document.getElementById('error-msg') as HTMLElement;
      const tombol = document.getElementById('btn-login') as HTMLButtonElement;
      const pw = document.getElementById('password') as HTMLInputElement;
      const togglePw = document.getElementById('toggle-pw') as HTMLButtonElement;
      const eyeOn = document.getElementById('eye-on') as unknown as HTMLElement;
      const eyeOff = document.getElementById('eye-off') as unknown as HTMLElement;

      // Tombol mata: tampilkan / sembunyikan password
      togglePw.addEventListener('click', () => {
        const tampil = pw.type === 'password';
        pw.type = tampil ? 'text' : 'password';
        eyeOn.classList.toggle('hidden', tampil);
        eyeOff.classList.toggle('hidden', !tampil);
        togglePw.setAttribute('aria-pressed', String(tampil));
        togglePw.setAttribute('aria-label', tampil ? 'Sembunyikan password' : 'Tampilkan password');
        pw.focus();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');
        tombol.disabled = true;
        tombol.textContent = 'Memeriksa...';

        const email = (document.getElementById('email') as HTMLInputElement).value;
        const password = pw.value;

        const { error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          errorMsg.textContent = error.message;
          errorMsg.classList.remove('hidden');
          tombol.disabled = false;
          tombol.textContent = 'Masuk ke Dashboard';
        } else {
          // Sesi sudah tersimpan di cookie, middleware akan mengizinkan akses
          window.location.href = '/dashboard';
        }
      });
    </script>
  </body>
</html>
---
import AdminLayout from '../layouts/AdminLayout.astro';

export const prerender = false;

const inputClass =
  'mt-1 block w-full rounded-md border border-slate-300 p-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-700';
---

<AdminLayout title="Input Logbook">

  <section class="bg-white p-6 rounded-lg border border-slate-200 max-w-3xl">
    <h2 class="text-lg font-semibold text-blue-900">Catat surat peminjaman</h2>
    <p class="text-sm text-slate-500 mt-1 mb-5">
      Setelah disimpan, sisa stok filamen dan jam pakai mesin diperbarui otomatis.
    </p>

    <form id="form-logbook" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-slate-700" for="nama_mahasiswa">Nama mahasiswa</label>
        <input id="nama_mahasiswa" type="text" name="nama_mahasiswa" required class={inputClass} placeholder="Trixie Glorianna" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="nim">NIM</label>
        <input id="nim" type="text" name="nim" required class={inputClass} placeholder="2224402402" />
      </div>

      <div>
  <label class="block text-sm font-medium text-slate-700" for="program_studi">
    Program studi
  </label>

  <select
    id="program_studi"
    name="program_studi"
    required
    class={inputClass}
  >
    <option value="" disabled selected>Pilih program studi</option>
    <option value="Teknologi Rekayasa Mekatronika">Teknologi Rekayasa Mekatronika</option>
    <option value="Teknologi Rekayasa Otomasi">Teknologi Rekayasa Otomasi</option>
    <option value="Teknologi Rekayasa Informatika Industri">
      Teknologi Rekayasa Informatika Industri
    </option>
    <option value="Teknologi Rekayasa Sistem Aerial Nirawak">
      Teknologi Rekayasa Sistem Aerial Nirawak
    </option>
    <option value="Sistem Siber-Fisik (Cyber Physical System)">
      Sistem Siber-Fisik (Cyber Physical System)
    </option>
  </select>
</div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="dosen_terkait">Dosen terkait</label>
        <input id="dosen_terkait" type="text" name="dosen_terkait" required class={inputClass} placeholder="Nama dosen pembimbing" />
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-slate-700" for="keperluan">Keperluan</label>
        <input id="keperluan" type="text" name="keperluan" required class={inputClass} placeholder="Pengerjaan Tugas Akhir" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="tanggal_pakai">Tanggal pakai</label>
        <input id="tanggal_pakai" type="date" name="tanggal_pakai" required class={inputClass} />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="volume_gram">Filamen terpakai (gram)</label>
        <input id="volume_gram" type="number" name="volume_gram" min="1" required class={inputClass} placeholder="15" />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="waktu_mulai">Jam mulai</label>
        <input id="waktu_mulai" type="time" name="waktu_mulai" required class={inputClass} />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700" for="waktu_selesai">Jam selesai</label>
        <input id="waktu_selesai" type="time" name="waktu_selesai" required class={inputClass} />
      </div>

      <div class="md:col-span-2 flex justify-end gap-3 mt-2">
        <a href="/" class="px-5 py-2 rounded-md border border-slate-300 text-sm font-medium text-slate-700 hover:bg-slate-50">
          Kembali ke dashboard
        </a>
        <button type="submit" id="tombol-simpan" class="bg-blue-900 text-white px-6 py-2 rounded-md hover:bg-blue-800 text-sm font-medium transition disabled:opacity-60">
          Simpan ke logbook
        </button>
      </div>
    </form>
  </section>

  <script>
    const form = document.getElementById('form-logbook') as HTMLFormElement | null;
    const tombol = document.getElementById('tombol-simpan') as HTMLButtonElement | null;
    const inputTanggal = document.getElementById('tanggal_pakai') as HTMLInputElement | null;

    function isiTanggalHariIni() {
  if (inputTanggal) inputTanggal.value = new Date().toLocaleDateString('en-CA');
}
    isiTanggalHariIni();

    if (form && tombol) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        tombol.disabled = true;
        tombol.textContent = 'Menyimpan...';

        try {
          const response = await fetch('/api/simpan-log', {
            method: 'POST',
            body: new FormData(form),
          });
          const result = await response.json();

          if (response.ok) {
            alert('Data logbook berhasil disimpan!');
            form.reset();
            isiTanggalHariIni();
          } else {
            alert('Gagal menyimpan: ' + (result.error || 'Terjadi kesalahan'));
          }
        } catch (err) {
          alert('Terjadi kesalahan jaringan.');
        } finally {
          tombol.disabled = false;
          tombol.textContent = 'Simpan ke logbook';
        }
      });
    }
  </script>

</AdminLayout>
---
import AdminLayout from '../layouts/AdminLayout.astro';
import { supabase } from '../lib/supabase';

export const prerender = false;

// ---------- Utilitas tanggal (zona waktu WIB) ----------
// Server (Vercel) berjalan di UTC, jadi "hari ini" dihitung eksplisit di Asia/Jakarta
const hariIni = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jakarta' }); // YYYY-MM-DD

const addDays = (iso: string, n: number) => {
  const d = new Date(iso + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
};
const valid = (s: string | null): s is string =>
  !!s && /^\d{4}-\d{2}-\d{2}$/.test(s) && !Number.isNaN(Date.parse(s + 'T00:00:00Z'));
const tanggalId = (t: string) => {
  const [y, m, d] = String(t).split('-');
  return y && m && d ? `${d}/${m}/${y}` : t;
};
const durasiId = (menit: number) => {
  const j = Math.floor((menit ?? 0) / 60);
  const m = (menit ?? 0) % 60;
  if (j === 0) return `${m} mnt`;
  return m === 0 ? `${j} jam` : `${j} jam ${m} mnt`;
};

// ---------- Rentang waktu dari URL (default: 7 hari terakhir) ----------
const q = Astro.url.searchParams;
let sampai = valid(q.get('sampai')) ? (q.get('sampai') as string) : hariIni;
let dari = valid(q.get('dari')) ? (q.get('dari') as string) : addDays(sampai, -6);

if (dari > sampai) [dari, sampai] = [sampai, dari];
if (sampai > hariIni) sampai = hariIni;
if (dari > sampai) dari = sampai;
const batasAwal = addDays(sampai, -365); // maksimal 1 tahun
if (dari < batasAwal) dari = batasAwal;

const jumlahHari =
  Math.round((Date.parse(sampai + 'T00:00:00Z') - Date.parse(dari + 'T00:00:00Z')) / 86400000) + 1;

const presets = [
  { label: '7 hari', dari: addDays(hariIni, -6) },
  { label: '30 hari', dari: addDays(hariIni, -29) },
  { label: 'Bulan ini', dari: hariIni.slice(0, 8) + '01' },
].map((p) => ({ ...p, sampai: hariIni }));
const presetAktif = presets.findIndex((p) => p.dari === dari && p.sampai === sampai);

// ---------- Ambil data dari Supabase ----------
const { data: printers } = await supabase.from('printers').select('*');
const { data: filaments } = await supabase.from('filaments').select('*');
const { data: logbooks } = await supabase
  .from('logbooks')
  .select('*')
  .gte('tanggal_pakai', dari)
  .lte('tanggal_pakai', sampai)
  .order('tanggal_pakai', { ascending: true });

const printerList = printers ?? [];
const filamentList = filaments ?? [];
const logList = logbooks ?? [];

// ---------- Ringkasan angka ----------
const totalGram = logList.reduce((sum, l) => sum + (l.volume_gram ?? 0), 0);
const totalMenit = logList.reduce((sum, l) => sum + (l.durasi_menit ?? 0), 0);
const totalJamMesin = totalMenit / 60;
const totalStok = filamentList.reduce((sum, f) => sum + (f.sisa_stok_gram ?? 0), 0); // kondisi saat ini
const mahasiswaUnik = new Set(logList.map((l) => l.nama_mahasiswa)).size;
const rataGram = totalGram / jumlahHari;

// ---------- Data grafik: satu titik per hari dalam rentang ----------
const gramMap = new Map<string, number>();
const menitMap = new Map<string, number>();
for (const l of logList) {
  const k = String(l.tanggal_pakai).slice(0, 10);
  gramMap.set(k, (gramMap.get(k) ?? 0) + (l.volume_gram ?? 0));
  menitMap.set(k, (menitMap.get(k) ?? 0) + (l.durasi_menit ?? 0));
}
const hari: string[] = [];
for (let i = 0; i < jumlahHari; i++) hari.push(addDays(dari, i));

const gramPerHari = hari.map((h) => gramMap.get(h) ?? 0);
const jamPerHari = hari.map((h) => Math.round(((menitMap.get(h) ?? 0) / 60) * 10) / 10);
const labelHari = hari.map((h) => {
  const [, m, d] = h.split('-');
  return `${d}/${m}`;
});
const adaGram = gramPerHari.some((v) => v > 0);
const adaJam = jamPerHari.some((v) => v > 0);

// ---------- Riwayat terbaru (dalam periode) ----------
const terbaru = [...logList].reverse().slice(0, 5);

const chartData = { labelHari, gramPerHari, jamPerHari };
const rentangTeks = `${tanggalId(dari)} – ${tanggalId(sampai)}`;

// Ikon (Heroicons outline)
const ICON = {
  logbook:
    'm16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10',
  cube: 'm21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
  stock:
    'm20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z',
  clock: 'M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
};

const kartu = [
  {
    label: 'Peminjaman tercatat',
    nilai: logList.length.toLocaleString('id-ID'),
    satuan: 'mahasiswa',
    icon: ICON.logbook,
    chip: 'bg-orange-50 text-orange-600',
  },
  {
    label: 'Filamen terpakai',
    nilai: totalGram.toLocaleString('id-ID'),
    satuan: 'g',
    icon: ICON.cube,
    chip: 'bg-blue-50 text-blue-900',
  },
  {
    label: 'Sisa stok filamen',
    nilai: totalStok.toLocaleString('id-ID'),
    satuan: 'g',
    icon: ICON.stock,
    chip: 'bg-emerald-50 text-emerald-700',
  },
  {
    label: 'Jam pakai mesin',
    nilai: totalJamMesin.toFixed(1),
    satuan: 'jam',
    ket: `${printerList.length} unit printer`,
    icon: ICON.clock,
    chip: 'bg-slate-100 text-slate-700',
  },
];
---

<AdminLayout title="Dashboard">

  <!-- Filter periode -->
  <section class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm text-slate-500">Periode data</p>
        <p class="font-semibold text-slate-900">
          {rentangTeks}
          <span class="ml-1 text-sm font-normal text-slate-500">· {jumlahHari} hari</span>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end">
        <div class="inline-flex h-10 items-stretch self-start rounded-lg bg-slate-100 p-1 sm:self-end" role="group" aria-label="Rentang cepat">
          {presets.map((p, i) => (
            <a
              href={`?dari=${p.dari}&sampai=${p.sampai}`}
              aria-current={i === presetAktif ? 'true' : undefined}
              class={
                'inline-flex items-center rounded-md px-3 text-sm font-medium transition ' +
                (i === presetAktif
                  ? 'bg-white text-blue-900 shadow-sm'
                  : 'text-slate-600 hover:text-slate-900')
              }
            >{p.label}</a>
          ))}
        </div>

        <form method="get" class="flex flex-wrap items-end gap-2">
          <label class="block text-xs font-medium text-slate-500">
            Dari
            <input
              type="date"
              name="dari"
              value={dari}
              max={hariIni}
              required
              class="mt-1 block h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </label>
          <label class="block text-xs font-medium text-slate-500">
            Sampai
            <input
              type="date"
              name="sampai"
              value={sampai}
              max={hariIni}
              required
              class="mt-1 block h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </label>
          <button
            type="submit"
            class="h-10 rounded-lg bg-blue-900 px-4 text-sm font-medium text-white transition hover:bg-blue-800"
          >Terapkan</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Ringkasan -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    {kartu.map((k) => (
      <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm text-slate-500">{k.label}</p>
          <span class={'grid place-items-center w-9 h-9 rounded-lg shrink-0 ' + k.chip}>
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={k.icon} />
            </svg>
          </span>
        </div>
        <p class="mt-3 text-2xl sm:text-3xl font-bold text-slate-900 tabular-nums">
          {k.nilai}{k.satuan && <span class="ml-1 text-base font-medium text-slate-400">{k.satuan}</span>}
        </p>
        <p class="mt-1 text-xs text-slate-500">{k.ket}</p>
      </div>
    ))}
  </section>

  <!-- Grafik -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-3 sm:gap-4">
    <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5">
      <h2 class="font-semibold text-slate-900">Filamen terpakai per hari</h2>
      <p class="text-sm text-slate-500">{rentangTeks}, dalam gram</p>
      <div class="relative mt-4 h-60">
        <canvas id="grafik-gram"></canvas>
        {!adaGram && (
          <p class="absolute inset-0 grid place-items-center text-sm text-slate-400 pointer-events-none">
            Belum ada pemakaian pada periode ini
          </p>
        )}
      </div>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5">
      <h2 class="font-semibold text-slate-900">Jam pemakaian mesin per hari</h2>
      <p class="text-sm text-slate-500">{rentangTeks}, dalam jam</p>
      <div class="relative mt-4 h-60">
        <canvas id="grafik-jam"></canvas>
        {!adaJam && (
          <p class="absolute inset-0 grid place-items-center text-sm text-slate-400 pointer-events-none">
            Belum ada pemakaian pada periode ini
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Riwayat terbaru -->
  <section class="bg-white rounded-xl border border-slate-200 overflow-hidden">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-4">
      <div>
        <h2 class="font-semibold text-slate-900">Peminjaman terbaru</h2>
        <p class="text-sm text-slate-500">5 catatan terakhir pada periode ini</p>
      </div>
      <a
        href="/riwayat_pemakaian"
        class="text-sm font-medium text-blue-900 hover:text-blue-700 hover:underline underline-offset-4 whitespace-nowrap"
      >Lihat semua</a>
    </div>

    {terbaru.length === 0
      ? (
        <div class="px-5 py-10 text-center border-t border-slate-100">
          <p class="text-sm text-slate-500">Tidak ada peminjaman pada periode ini.</p>
          <a
            href="/logbook"
            class="mt-3 inline-block rounded-lg bg-blue-900 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 transition"
          >Input logbook</a>
        </div>
      )
      : (
        <div class="overflow-x-auto border-t border-slate-100">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 text-slate-500">
              <tr>
                <th class="py-2.5 pl-4 sm:pl-5 pr-4 font-medium whitespace-nowrap">Tanggal</th>
                <th class="py-2.5 pr-4 font-medium">Mahasiswa</th>
                <th class="py-2.5 pr-4 font-medium">Keperluan</th>
                <th class="py-2.5 pr-4 font-medium">Dosen</th>
                <th class="py-2.5 pr-4 font-medium text-right">Durasi</th>
                <th class="py-2.5 pr-4 sm:pr-5 font-medium text-right">Filamen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {terbaru.map((l) => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-3 pl-4 sm:pl-5 pr-4 whitespace-nowrap text-slate-700">{tanggalId(l.tanggal_pakai)}</td>
                  <td class="py-3 pr-4">
                    <p class="font-medium text-slate-900">{l.nama_mahasiswa}</p>
                    <p class="text-xs text-slate-500">{l.program_studi}</p>
                  </td>
                  <td class="py-3 pr-4 text-slate-700">{l.keperluan}</td>
                  <td class="py-3 pr-4 text-slate-700">{l.dosen_terkait ?? '-'}</td>
                  <td class="py-3 pr-4 text-right whitespace-nowrap text-slate-700 tabular-nums">{durasiId(l.durasi_menit)}</td>
                  <td class="py-3 pr-4 sm:pr-5 text-right whitespace-nowrap font-medium text-slate-900 tabular-nums">{l.volume_gram} g</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
  </section>

  <!-- Data grafik dari server -->
  <script type="application/json" id="chart-data" set:html={JSON.stringify(chartData)}></script>

  <!-- Chart.js dari CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

  <!-- Menggambar grafik -->
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('chart-data').textContent);
      var biru = '#1e3a8a';
      var oranye = '#ea580c';
      var teks = '#64748b';
      var garis = '#eef2f7';

      Chart.defaults.font.family = 'ui-sans-serif, system-ui, sans-serif';
      Chart.defaults.color = teks;

      // Label sumbu X dihitung mundur dari hari terakhir, jadi hari terakhir selalu berlabel
      var n = data.labelHari.length;
      var langkah = Math.max(1, Math.ceil(n / 10));
      function labelX(value, index) {
        return (n - 1 - index) % langkah === 0 ? this.getLabelForValue(value) : null;
      }

      function opsi(satuan, bulat) {
        return {
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { top: 8, right: 8 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#0f172a',
              padding: 10,
              cornerRadius: 8,
              displayColors: false,
              callbacks: {
                label: function (ctx) { return ctx.parsed.y + ' ' + satuan; },
              },
            },
          },
          scales: {
            x: {
              offset: true,
              grid: { display: false },
              border: { display: false },
              ticks: { autoSkip: false, maxRotation: 0, callback: labelX },
            },
            y: {
              beginAtZero: true,
              grace: '10%',
              grid: { color: garis },
              border: { display: false },
              ticks: bulat ? { precision: 0 } : {},
            },
          },
        };
      }

      function buat(id, config) {
        var el = document.getElementById(id);
        if (el) new Chart(el, config);
      }

      buat('grafik-gram', {
        type: 'bar',
        data: {
          labels: data.labelHari,
          datasets: [{
            label: 'Gram',
            data: data.gramPerHari,
            backgroundColor: biru,
            hoverBackgroundColor: '#1d4ed8',
            borderRadius: 4,
            maxBarThickness: 26,
            barPercentage: 0.85,
            categoryPercentage: 0.9,
          }],
        },
        options: opsi('g', true),
      });

      buat('grafik-jam', {
        type: 'line',
        data: {
          labels: data.labelHari,
          datasets: [{
            label: 'Jam',
            data: data.jamPerHari,
            borderColor: oranye,
            borderWidth: 2,
            backgroundColor: 'rgba(234,88,12,0.08)',
            fill: true,
            cubicInterpolationMode: 'monotone',
            pointRadius: function (ctx) { return ctx.raw > 0 ? 3 : 0; },
            pointBackgroundColor: oranye,
            pointHoverRadius: 5,
            pointHoverBackgroundColor: oranye,
          }],
        },
        options: opsi('jam', false),
      });
    })();
  </script>

</AdminLayout>